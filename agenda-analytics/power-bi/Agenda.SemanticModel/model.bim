{
  "name": "Agenda Analytics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Agenda",
        "columns": [
          {
            "name": "id",
            "sourceColumn": "id",
            "dataType": "int64",
            "summarizeBy": "none"
          },
          {
            "name": "data_prevista",
            "sourceColumn": "data_prevista",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "unidade",
            "sourceColumn": "unidade",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "turno",
            "sourceColumn": "turno",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "desfecho",
            "sourceColumn": "desfecho",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "mes",
            "sourceColumn": "mes",
            "dataType": "string",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Agendamentos",
            "expression": "COUNTROWS(Agenda)",
            "formatString": "#,0"
          },
          {
            "name": "Cancelamentos",
            "expression": "CALCULATE([Agendamentos], Agenda[desfecho] = \"cancelado\")",
            "formatString": "#,0"
          },
          {
            "name": "Faltas",
            "expression": "CALCULATE([Agendamentos], Agenda[desfecho] = \"falta\")",
            "formatString": "#,0"
          },
          {
            "name": "Elegíveis",
            "expression": "CALCULATE([Agendamentos], Agenda[desfecho] IN {\"realizado\", \"falta\"})",
            "formatString": "#,0"
          },
          {
            "name": "Taxa de falta",
            "expression": "DIVIDE([Faltas], [Elegíveis])",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "Agenda",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate),",
                "    Csv = Csv.Document(Bytes, [Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),",
                "    Fields = Table.SelectColumns(Headers, {\"id\", \"data_prevista\", \"unidade_id\", \"turno\", \"desfecho\"}),",
                "    Unit = Table.AddColumn(Fields, \"unidade\", each Record.Field([N=\"Norte\", S=\"Sul\", C=\"Centro\"], [unidade_id]), type text),",
                "    Month = Table.AddColumn(Unit, \"mes\", each Text.Start([data_prevista], 7), type text),",
                "    Output = Table.TransformColumnTypes(Table.RemoveColumns(Month, {\"unidade_id\"}), {{\"id\", Int64.Type}})",
                "in",
                "    Output"
              ]
            }
          }
        ]
      }
    ]
  }
}
